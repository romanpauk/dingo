#pragma once

#include <cstddef>
#include <cstdint>

// The storage kinds of the spec as constexpr data: the kind of a stored type
// by the properties of its outer wrappers, and the request categories a scope
// exposes for each.

namespace dingo {

// The request categories a scope exposes, as bits.
enum class request_category : std::uint8_t {
  none = 0,
{% for category in request_categories %}
  {{ category.name }} = {{ category.bit }},
{% endfor %}
};

constexpr bool exposes(std::uint8_t categories, request_category category) {
  return (categories & static_cast<std::uint8_t>(category)) != 0;
}

// spec: storage_kinds
enum class storage_kind : std::uint8_t {
{% for kind in storage_kinds %}
  {{ kind.id }},
{% endfor %}
};

inline constexpr std::size_t storage_kind_count = {{ storage_kinds | length }};

// A class of wrappers: the property bits a wrapper has, and those it lacks.
struct property_class {
  bool any;
  std::uint16_t has;
  std::uint16_t lacks;
};

// A storage kind: the class of the outer wrapper of a stored type tree, and of the
// wrapper of its element; a kind of no outer class is the plain one.
struct storage_kind_info {
  storage_kind kind;
  property_class outer;
  property_class inner;
};

inline constexpr storage_kind_info storage_kinds[] = {
{% for kind in storage_kinds %}
    {storage_kind::{{ kind.id }}, {% if kind.outer %}{true, {{ kind.outer.has }}, {{ kind.outer.lacks }}}{% else %}{false, 0, 0}{% endif %}, {% if kind.inner %}{true, {{ kind.inner.has }}, {{ kind.inner.lacks }}}{% else %}{false, 0, 0}{% endif %}},
{% endfor %}
};

} // namespace dingo
