#pragma once

#include <dingo/core/vocabulary/route_forms.gen.h>

#include <cstddef>
#include <cstdint>

// The vocabulary of the spec as constexpr data: the storage forms, scopes,
// selection rules, and key kinds the engine of the next implementation
// interprets, beside the shape algebra of route_forms.gen.h.

namespace dingo::core {

// The request categories a scope exposes, as bits.
enum class request_category : std::uint8_t {
  none = 0,
{% for category in request_categories %}
  {{ category.name }} = {{ category.bit }},
{% endfor %}
};

constexpr bool exposes(std::uint8_t categories, request_category category) {
  return (categories & static_cast<std::uint8_t>(category)) != 0;
}

// spec: storage_forms
enum class storage_form : std::uint8_t {
{% for form in storage_forms %}
  {{ form.id }},
{% endfor %}
};

inline constexpr std::size_t storage_form_count = {{ storage_forms | length }};

// A class of layers: the property bits a layer has, and those it lacks.
struct layer_class {
  bool any;
  std::uint16_t has;
  std::uint16_t lacks;
};

// A storage form: the class of the outer layer of a stored shape, and of the
// layer of its element; a form of no outer class is the plain one.
struct storage_form_info {
  storage_form form;
  layer_class outer;
  layer_class inner;
};

inline constexpr storage_form_info storage_forms[] = {
{% for form in storage_forms %}
    {storage_form::{{ form.id }}, {% if form.outer %}{true, {{ form.outer.has }}, {{ form.outer.lacks }}}{% else %}{false, 0, 0}{% endif %}, {% if form.inner %}{true, {{ form.inner.has }}, {{ form.inner.lacks }}}{% else %}{false, 0, 0}{% endif %}},
{% endfor %}
};

// spec: scopes
enum class slot : std::uint8_t {
{% for value in slots %}
  {{ value }},
{% endfor %}
};

enum class recursion_guard : std::uint8_t {
{% for value in guards %}
  {{ value }},
{% endfor %}
};

enum class exposure_rule : std::uint8_t {
{% for value in exposure_rules %}
  {{ value }},
{% endfor %}
};

// The descriptor of a scope, the fields of the spec's Scope schema. A scope
// is a type whose dingo::scope_traits specialization holds its descriptor, so
// a user scope needs no id of a closed list.
struct scope_info {
  slot storage_slot;
  value_category materializes;
  bool stable;
  bool consumes;
  recursion_guard guard;
  bool retains_unresolved_source;
  exposure_rule rule;
  bool nested_layers;
  bool needs_instance;
  // The request categories exposed per storage form, indexed by storage_form.
  std::uint8_t exposures[storage_form_count];
};

// spec: selection_rules
enum class selection_source : std::uint8_t {
{% for source in selection_sources %}
  {{ source }},
{% endfor %}
};

enum class selection_mode : std::uint8_t {
{% for mode in selection_modes %}
  {{ mode }},
{% endfor %}
};

// The condition on the request under which a step is taken.
enum class step_condition : std::uint8_t {
{% for condition in step_conditions %}
  {{ condition }},
{% endfor %}
};

enum class selection_status : std::uint8_t { ok, ambiguous, not_found };

inline constexpr std::size_t max_selection_steps = {{ max_selection_steps }};
inline constexpr std::size_t max_step_sources = {{ max_step_sources }};

// The union of the sources of a step, taken when the request meets its
// condition `when`.
struct selection_step {
  selection_source sources[max_step_sources];
  std::size_t source_count;
  step_condition when;
};

// A selection rule answers a request from the first step that names a
// binding, or from all of them if not `first_non_empty`, and its status
// follows from the number of bindings named.
struct selection_rule {
  selection_mode mode;
  bool first_non_empty;
  selection_step steps[max_selection_steps];
  std::size_t step_count;
  selection_status empty;
  selection_status one;
  selection_status many;
};

inline constexpr selection_rule selection_rules[] = {
{% for rule in selection_rules %}
    // spec: selection_rules.{{ rule.id }}
    {selection_mode::{{ rule.mode }}, {{ rule.first_non_empty | lower }},
     { {% for step in rule.steps %}{ { {% for source in step.sources %}selection_source::{{ source }}{{ ", " if not loop.last }}{% endfor %} }, {{ step.sources | length }}, step_condition::{{ step.when }} }{{ ", " if not loop.last }}{% endfor %} },
     {{ rule.steps | length }}, selection_status::{{ rule.empty }}, selection_status::{{ rule.one }}, selection_status::{{ rule.many }}},
{% endfor %}
};

constexpr const selection_rule &rule_of(selection_mode mode) {
  for (const selection_rule &rule : selection_rules) {
    if (rule.mode == mode) {
      return rule;
    }
  }
  return selection_rules[0];
}

// spec: key_kinds
enum class key_kind : std::uint8_t {
{% for kind in key_kinds %}
  {{ kind.id }},
{% endfor %}
};

// Whether a key of the kind carries a value, which is compared, indexed by
// key_kind.
inline constexpr bool key_kind_values[] = {
{% for kind in key_kinds %}
    {{ kind.has_value | lower }},
{% endfor %}
};

constexpr bool has_value(key_kind kind) {
  return key_kind_values[static_cast<std::size_t>(kind)];
}

} // namespace dingo::core
