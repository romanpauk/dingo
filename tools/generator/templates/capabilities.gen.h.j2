#pragma once
{% for header in headers %}

#if __has_include(<{{ header }}>)
#include <{{ header }}> // IWYU pragma: keep
#endif
{% endfor %}
{% for capability in capabilities %}
{% set macro = "DINGO_HAS_" ~ capability.id | upper %}

// spec: cpp.capabilities.{{ capability.id }}
{% for line in capability.description_lines %}
// {{ line }}
{% endfor %}
{% if capability.builtin %}
#if defined(__has_builtin)
#if __has_builtin({{ capability.builtin }})
#define {{ macro }} 1
#else
#define {{ macro }} 0
#endif
#else
#define {{ macro }} 0
#endif
{% else %}
#if defined({{ capability.feature_macro }}) && {{ capability.feature_macro }} >= {{ capability.minimum }}L
#define {{ macro }} 1
#else
#define {{ macro }} 0
#endif
{% endif %}
{% endfor %}
