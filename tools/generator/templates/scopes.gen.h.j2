// The descriptor of a scope, the fields of the spec's Scope schema. A scope
// is a type whose dingo::scope_traits specialization holds its descriptor, so
// a user scope needs no id of a closed list.
struct scope_info {
  slot storage_slot;
  value_category materializes;
  bool stable;
  bool consumes;
  recursion_guard guard;
  bool retains_unresolved_source;
  exposure_rule rule;
  bool nested_wrappers;
  bool needs_instance;
  // The request categories exposed per storage form, indexed by storage_form.
  std::uint8_t exposures[storage_form_count];
};

} // namespace dingo::core

// The public tags of the built-in scopes, and the scope_traits that make a
// tag type a scope.

namespace {{ namespace }} {
{% for tag in tags %}

// spec: scopes.{{ tag.scope }}
struct {{ tag.name }} {};
{% endfor %}

// The descriptor of a scope: the fields of the spec's Scope schema.
using scope_descriptor = core::scope_info;

// Makes `Tag` a scope. A specialization holds its descriptor,
//
//   static constexpr scope_descriptor descriptor = ...;
//
// which a user scope may copy from a built-in scope and change, and may name
// a slot class of its own that keeps the contract of the slot kind of its
// descriptor,
//
//   template <typename Binding> using slot = ...;
//
// deriving from scope_slot<Binding>, which supplies the factory of the
// binding and the context of its walks.
template <typename Tag> struct scope_traits;
{% for tag in tags %}

template <> struct scope_traits<::{{ namespace }}::{{ tag.name }}> {
  static constexpr scope_descriptor descriptor = {core::slot::{{ tag.fields.slot }}, core::value_category::{{ tag.fields.materializes }}, {{ tag.fields.stable | lower }}, {{ tag.fields.consumes | lower }}, core::recursion_guard::{{ tag.fields.guard }}, {{ tag.fields.retains | lower }}, core::exposure_rule::{{ tag.fields.exposure_rule }}, {{ tag.fields.nested_wrappers | lower }}, {{ tag.fields.needs_instance | lower }}, { {{ tag.fields.exposures | join(", ") }} }};
};
{% endfor %}

} // namespace {{ namespace }}

namespace dingo::core {

// The descriptor of the scope `Tag`.
template <typename Tag>
inline constexpr const scope_info &scope_of_v =
    ::{{ namespace }}::scope_traits<Tag>::descriptor;

} // namespace dingo::core
