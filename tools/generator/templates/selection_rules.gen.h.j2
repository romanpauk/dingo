#pragma once

#include <cstddef>
#include <cstdint>

// The selection rules of the spec as constexpr data: which sources answer a
// request of each mode, and the status of the number of bindings they name.

namespace dingo {

// spec: selection_rules
enum class selection_source : std::uint8_t {
{% for source in selection_sources %}
  {{ source }},
{% endfor %}
};

enum class selection_mode : std::uint8_t {
{% for mode in selection_modes %}
  {{ mode }},
{% endfor %}
};

// The condition on the request under which a step is taken.
enum class step_condition : std::uint8_t {
{% for condition in step_conditions %}
  {{ condition }},
{% endfor %}
};

enum class selection_status : std::uint8_t { ok, ambiguous, not_found };

// The union of the sources of a step, taken when the request meets its
// condition `when`.
struct selection_step {
  const selection_source *sources;
  std::size_t source_count;
  step_condition when;
};

// A selection rule answers a request from the first step that names a
// binding, or from all of them if not `first_non_empty`, and its status
// follows from the number of bindings named.
struct selection_rule {
  selection_mode mode;
  bool first_non_empty;
  const selection_step *steps;
  std::size_t step_count;
  selection_status empty;
  selection_status one;
  selection_status many;
};

// The sources of each step of each rule, and the steps of each rule, in arrays
// of exactly as many.
{% for rule in selection_rules %}
{% for step in rule.steps %}
inline constexpr selection_source {{ rule.id }}_sources_{{ loop.index0 }}[] = { {% for source in step.sources %}selection_source::{{ source }}{{ ", " if not loop.last }}{% endfor %} };
{% endfor %}

inline constexpr selection_step {{ rule.id }}_steps[] = {
{% for step in rule.steps %}
    { {{ rule.id }}_sources_{{ loop.index0 }}, {{ step.sources | length }}, step_condition::{{ step.when }} },
{% endfor %}
};
{% endfor %}

inline constexpr selection_rule selection_rules[] = {
{% for rule in selection_rules %}
    // spec: selection_rules.{{ rule.id }}
    {selection_mode::{{ rule.mode }}, {{ rule.first_non_empty | lower }},
     {{ rule.id }}_steps, {{ rule.steps | length }}, selection_status::{{ rule.empty }}, selection_status::{{ rule.one }}, selection_status::{{ rule.many }}},
{% endfor %}
};

constexpr const selection_rule &rule_of(selection_mode mode) {
  for (const selection_rule &rule : selection_rules) {
    if (rule.mode == mode) {
      return rule;
    }
  }
  return selection_rules[0];
}

} // namespace dingo
