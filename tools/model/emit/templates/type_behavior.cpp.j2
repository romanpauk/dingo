enum class delete_kind { none, single, array };

// A consuming scope transfers a raw pointer result to its caller. An array
// pointer is released through its element pointer so the array cookie matches
// the allocation.
template <delete_kind Delete, typename T> void release(T *value) {
  if constexpr (Delete == delete_kind::array) {
    if constexpr (std::is_array_v<T>) {
      delete[] &(*value)[0];
    } else {
      delete[] value;
    }
  } else if constexpr (Delete == delete_kind::single) {
    delete value;
  } else {
    (void)value;
  }
}

template <typename Request, bool Stable, delete_kind Delete, typename Container>
void probe(Container &container) {
  if constexpr (std::is_rvalue_reference_v<Request> &&
                std::is_const_v<std::remove_reference_t<Request>>) {
    // A const rvalue request is a lift artefact: the library cannot produce a
    // const object to bind it to, so there is no runtime probe.
    (void)container;
  } else if constexpr (std::is_rvalue_reference_v<Request>) {
    auto &&value = container.template resolve<Request>();
    if constexpr (std::is_constructible_v<
                      std::remove_cv_t<std::remove_reference_t<Request>>,
                      Request>) {
      auto moved = std::move(value);
      (void)moved;
    } else {
      (void)value;
    }
  } else if constexpr (std::is_lvalue_reference_v<Request>) {
    auto &first = container.template resolve<Request>();
    auto &second = container.template resolve<Request>();
    if constexpr (Stable) {
      EXPECT_EQ(std::addressof(first), std::addressof(second));
    } else {
      EXPECT_NE(id_of(first), id_of(second));
    }
  } else if constexpr (std::is_pointer_v<Request>) {
    auto first = container.template resolve<Request>();
    auto second = container.template resolve<Request>();
    if constexpr (Stable) {
      EXPECT_EQ(first, second);
    } else {
      EXPECT_NE(id_of(*first), id_of(*second));
    }
    release<Delete>(first);
    release<Delete>(second);
  } else {
    auto first = container.template resolve<Request>();
    auto second = container.template resolve<Request>();
    if constexpr (Stable) {
      EXPECT_EQ(id_of(first), id_of(second));
    } else {
      EXPECT_NE(id_of(first), id_of(second));
    }
  }
}

