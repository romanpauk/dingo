    using lift = dingo::detail::request_lift<Request>;
    return direct_supported<Request, Storage>() ||
           request_supported_impl<typename lift::inner_type, Storage>();
  } else {
    return direct_supported<Request, Storage>();
  }
}

template <typename Request, typename Storage>
constexpr bool request_supported() {
