inline std::string json_escape(const std::string &value) {
  std::string result;
  result.reserve(value.size());
  for (char character : value) {
    switch (character) {
    case '\\':
      result += "\\\\";
      break;
    case '"':
      result += "\\\"";
      break;
    case '\n':
      result += "\\n";
      break;
    default:
      result += character;
      break;
    }
  }
  return result;
}

template <typename Request> std::string lifted_reason() {
  if constexpr (dingo::detail::request_lift<Request>::enabled) {
    return std::string("lifted from ") +
           dingo::type_name<typename dingo::detail::request_lift<
               Request>::inner_type>();
  } else {
    return "lifted";
  }
}

