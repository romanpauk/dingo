{% import "registration.j2" as reg %}
// Generated by spec/conversion.py. Do not edit.
#include "model/conversion.h"
{% for header in headers %}
#include {{ header }}
{% endfor %}

using namespace dingo::model;
{% if part == "requests" %}

// The runtime requests of the interface {{ interface }}.
namespace {
using I = {{ interface }};
}

extern const dingo::detail::runtime_request *const {{ name }}[] = {
{% for spelled in requests %}
    &dingo::detail::runtime_request_v<{{ spelled }}>,
{% endfor %}
};
{% elif part == "bindings" %}

{% for u, index in bindings %}
// {{ u.name }}
struct binding_{{ loop.index0 }} {
{% for bound in u.interfaces() %}
  using I{{ loop.index0 }} = {{ bound.spelled }};
{% endfor %}
  using registration = {{ reg.registration(u) }};
  using interface_type = I{{ index }};
};

{% endfor %}
extern const binding_tables {{ name }}[] = {
{% for u, index in bindings %}
    binding_tables_v<binding_{{ loop.index0 }}::registration,
                      binding_{{ loop.index0 }}::interface_type>(),
{% endfor %}
};
{% else %}

{% for each in requests %}
extern const dingo::detail::runtime_request *const {{ each }}[];
{% endfor %}
{% for each in bindings %}
extern const binding_tables {{ each }}[];
{% endfor %}

// The pairs of a binding and a request the program records, in their order.
struct selected_pair {
  const binding_tables *binding;
  const dingo::detail::runtime_request *const *request;
};

int main() {
  static const selected_pair pairs[] = {
{% for binding, request in pairs %}
      {&{{ binding }}, &{{ request }}},
{% endfor %}
  };
  for (std::size_t index = 0; index < sizeof(pairs) / sizeof(pairs[0]);
       ++index) {
    record_selected(index, *pairs[index].binding, **pairs[index].request);
  }
}
{% endif %}
