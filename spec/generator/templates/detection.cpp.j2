{% import "macros.j2" as cpp %}
{#- The class template of detection.h for each Kind. -#}
{% set KIND = {
  "single": "single",
  "explicit_single": "explicit_single",
  "aggregate": "aggregate",
  "pair": "pair",
} %}
{% set keyed = unit.selection.value == "keyed" %}
{#- The class generated around the parameter a probe requests. -#}
{% macro made(probe) -%}
{{ KIND[unit.kind.value] }}<{{ cpp.selected(unit.selection, cpp.request(probe.request)) }}>
{%- endmacro %}
{#- The factory of a constructor, or none for shape detection. -#}
{% macro factory(probe) -%}
{% set parameter = "parameter_t<" ~ cpp.selected(unit.selection, cpp.request(probe.request)) ~ ">" %}
{% if probe.operation.construction.value == "explicit" -%}
dingo::constructor<{{ made(probe) }}({{ ([parameter] * unit.kind.arity) | join(", ") }})>
{%- elif probe.operation.construction.value == "signature" -%}
dingo::constructor_detection<{{ made(probe) }}, dingo::detail::constructor_signature>
{%- endif %}
{%- endmacro %}
{#- The registration a class is made of. -#}
{% macro binding(probe) -%}
dingo::bind<dingo::scope<dingo::shared>, dingo::storage<{{ made(probe) }}>
{%- if factory(probe) %}, dingo::factory<{{ factory(probe) }}>{% endif %}>
{%- endmacro %}
{#- The statements that make the class in c, and return whether it reached
    the leaf. -#}
{% macro make(probe) -%}
{% set making = probe.operation.making.value %}
{% if making == "registered" -%}
auto &made = c.template resolve<{{ made(probe) }} &>(); return reading<{{ made(probe) }}>::reached(made);
{%- elif making == "invoke" -%}
return c.invoke([]({{ made(probe) }} arg) { return reading<{{ made(probe) }}>::reached(arg); });
{%- else -%}
auto made = c.template {{ making }}<{{ made(probe) }}>({{ factory(probe) }}{{ "()" if factory(probe) }}); return reading<{{ made(probe) }}>::reached(made);
{%- endif %}
{%- endmacro %}
{% if unit.provider %}
{% set scope, form = unit.provider %}
{% set arguments = "dingo::scope<dingo::" ~ scope.value ~ ">, dingo::storage<" ~ cpp.stored(form, unit.leaf)
   ~ ">, dingo::interfaces<" ~ cpp.bound(unit.selection, "I0") ~ ">" %}
{% set static_arguments = arguments ~ (", " ~ cpp.KEY if keyed else "") %}
{% set registered = "" if unit.container.value == "static" else
   "c.template register_type<" ~ arguments ~ ">(" ~ ("dingo::key_value{std::size_t(1)}" if keyed else "") ~ ");" %}
{% endif %}
// Generated by spec/detection.py. Do not edit.
#include "model/detection.h"

using namespace dingo::model;

// The interface the parameters are shapes of.
using I0 = {{ unit.interface.spelled }};

template <typename Container> void run() {
{% for probe in probes %}
    // probe {{ loop.index0 }}
{% if unit.container is none %}
    record_detection<{{ made(probe) }}, dingo::detail::constructor_{{ probe.operation.detection.value }}>("{{ unit.cell(probe) }}");
{% elif probe.operation.making.value == "registered" %}
    construct_probe<typename with_binding<Container, {{ binding(probe) }}>::type>(
        "{{ unit.cell(probe) }}",
        [](auto &c) { {{ registered }} registers<{{ binding(probe) }}>::in(c); },
        [](auto &c) { {{ make(probe) }} });
{% else %}
    construct_probe<Container>(
        "{{ unit.cell(probe) }}",
        [](auto &c) { {{ registered }} },
        [](auto &c) { {{ make(probe) }} });
{% endif %}
{% endfor %}
    // probes end
}

int main() { run<{{ cpp.container(unit.container, cpp.traits(unit.container, keyed, "I0"), static_arguments) if unit.container else "void" }}>(); }
