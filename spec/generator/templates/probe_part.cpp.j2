{% import "macros.j2" as cpp %}
{% import "registration.j2" as reg %}
{% set selection = r.selection %}
{% macro dependency(probe) -%}
{{ cpp.selected(selection, cpp.request(probe.request)) }}
{%- endmacro %}
{#- The expression that makes the request of a probe in container c. -#}
{% macro make(probe) -%}
{% set selected = dependency(probe) %}
{% set entry = probe.operation.entry.value %}
{% set kept = probe.operation.position.kept_by %}
{% if probe.operation.position.value == "direct" -%}
{% if entry == "invoke" -%}
c.invoke([]({{ selected }} arg) { return received<{{ selected }}>(pass_on<{{ selected }}>(arg)); })
{%- elif entry == "construct" -%}
c.template construct<{{ selected }}>()
{%- elif r.selection.value == "keyed" and r.container.value == "runtime" -%}
c.template resolve<{{ cpp.request(probe.request) }}>(std::size_t(1))
{%- else -%}
c.template resolve<{{ selected }}>()
{%- endif %}
{%- else -%}
{% set made = "consumer<" ~ selected ~ ">" ~ (" &" if kept else "") %}
{% if entry == "invoke" -%}
c.invoke([]({{ made }} arg) -> {{ made }} { return {{ "arg" if kept else "std::move(arg)" }}; })
{%- else -%}
c.template {{ entry }}<{{ made }}>()
{%- endif %}
{%- endif %}
{%- endmacro %}
{#- The container a probe is made in, within run<Container>. -#}
{% macro probed_container(probe) -%}
{% set kept = probe.operation.position.kept_by %}
{% if kept -%}
typename with_consumer<Container, {{ dependency(probe) }}, dingo::{{ kept.value }}>::type
{%- else -%}
Container
{%- endif %}
{%- endmacro %}
{#- The statements that register what a probe needs in c. -#}
{% macro setup(probe) -%}
{% set kept = probe.operation.position.kept_by %}
{{ reg.registered(r) }}
{%- if kept %} register_consumer<{{ dependency(probe) }}, dingo::{{ kept.value }}>(c);{% endif %}
{%- endmacro %}
{% set keys %}{% for bound in r.interfaces() %}I{{ loop.index0 }}{{ ", " if not loop.last }}{% endfor %}{% endset %}
// {{ r.name }}
namespace part_{{ part }} {

// The interfaces the registration binds.
{% for bound in r.interfaces() %}
using I{{ loop.index0 }} = {{ bound.spelled }};
{% endfor %}

// The container is a template parameter, so that the calls on it are
// dependent and the branch not taken is discarded.
template <typename Container> void run() {
  if constexpr (registrable<{{ reg.registration(r) }}, {{ "true" if r.container.value == "static" else "false" }}>()) {
{% if registers %}
    // The registration alone, which every probe of it makes.
    { Container c; {{ reg.registered(r) }} (void)c; }
{% endif %}
{% if checks %}
{% for index, bound, requests in r.checks() %}
    check_probed<{{ reg.registration(r) }}, I{{ index }}{% for request in requests %}, {{ cpp.request(request) }}{% endfor %}>("{{ r.published_prefix(bound) }}");
{% endfor %}
{% endif %}
{% if r.scope.value == "external" %}
    // What the scope is given outlives the probes; make it first, so that
    // they do not count it as leaked.
    (void){{ reg.given(r) }};
{% endif %}
{% for probe in probes %}
    // probe {{ first + loop.index0 }}
    probe<{{ probed_container(probe) }}>(
        "{{ r.cell(probe) }}", keeps::{{ r.keeps(probe).value }},
        [](auto &c) { {{ setup(probe) }} },
        [](auto &c) -> decltype(auto) { return {{ make(probe) }}; });
{% endfor %}
    // probes end
  } else {
{% for probe in probes %}
    record("{{ r.cell(probe) }}", "not_registrable");
{% endfor %}
  }
}

void run_part() { run<{{ cpp.container(r.container, cpp.traits(r.container, r.selection.value == "keyed", keys), reg.static_arguments(r)) }}>(); }

} // namespace part_{{ part }}
